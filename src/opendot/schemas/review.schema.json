{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenDot review step output",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "verdict", "reason"],
        "properties": {
          "action_id": {"type": "integer"},
          "verdict": {
            "type": "string",
            "enum": ["approve", "deny", "escalate_to_user"]
          },
          "reason": {"type": "string"}
        }
      }
    }
  }
}
